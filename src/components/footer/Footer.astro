---
import config from '../../config';
import { useTranslations } from '../../lib/i18n';
import { getAllPosts, getWordCount } from '../../lib/posts';
import { urlFor } from '../../lib/url';

const t = useTranslations();
const posts = await getAllPosts();
const totalWords = posts.reduce((total, post) => total + getWordCount(post.body ?? ''), 0);
const startYear = new Date(config.footer.start).getUTCFullYear();
const currentYear = new Date().getUTCFullYear();
const number = new Intl.NumberFormat('en-US');
---

<footer class="footer mt-5 py-5 h-auto text-base text-third-text-color relative border-t-2 border-t-border-color">
  <div class="info-container py-3 text-center">
    {config.footer.customize && (
      <div class="customize-info my-1" set:html={config.footer.customize} />
    )}
    <div class="text-center">
      &copy;
      {startYear && <span>{startYear}</span>}
      -
      {currentYear}&nbsp;&nbsp;
      <Fragment set:html={config.footer.icon} />&nbsp;&nbsp;
      <a href={urlFor('/')}>{config.site.author}</a>
      {config.footer.statistics && (
        <p class="post-count space-x-0.5">
          <span>{t('site_posts', number.format(posts.length))}</span>
          <span>{t('site_wordcount', number.format(totalWords))}</span>
        </p>
      )}
    </div>

    {config.global.websiteCounter.enable && (
      <div class="relative text-center lg:absolute lg:right-[20px] lg:top-1/2 lg:-translate-y-1/2 lg:text-right">
        {config.global.websiteCounter.siteUv && (
          <span id="busuanzi_container_site_uv" class="lg:!block">
            <span class="text-sm mr-1.5">{t('site_uv')}</span>
            <span id="busuanzi_value_site_uv"></span>
          </span>
        )}
        {config.global.websiteCounter.sitePv && (
          <span id="busuanzi_container_site_pv" class="lg:!block">
            <span class="text-sm mr-1.5">{t('site_pv')}</span>
            <span id="busuanzi_value_site_pv"></span>
          </span>
        )}
      </div>
    )}

    <div class="relative text-center lg:absolute lg:left-[20px] lg:top-1/2 lg:-translate-y-1/2 lg:text-left">
      <span
        class="lg:block text-sm"
        set:html={t('powered_by', '<a target="_blank" class="text-base" rel="noopener" href="https://astro.build">Astro</a>')}
      />
      <span class="text-sm lg:block">
        {t('theme')}&nbsp;
        <span class="text-base">Redefine for Astro v1.0.0</span>
      </span>
    </div>

    {config.footer.icp.enable && config.footer.icp.number && (
      <div class="icp-info my-1">
        <a target="_blank" rel="nofollow noopener" href={config.footer.icp.url || 'https://beian.miit.gov.cn'}>
          {config.footer.icp.number}
        </a>
      </div>
    )}

    {config.footer.runtime && (
      <div data-runtime-start={config.footer.start}>
        {t('runtime')} <span class="odometer" id="runtime_days">0</span> {t('days')}{' '}
        <span class="odometer" id="runtime_hours">0</span> {t('hours')}{' '}
        <span class="odometer" id="runtime_minutes">0</span> {t('minutes')}{' '}
        <span class="odometer" id="runtime_seconds">0</span> {t('seconds')}
      </div>
    )}

    {config.inject.enable && config.inject.footer.filter(Boolean).map((html) => (
      <Fragment set:html={html} />
    ))}
  </div>
</footer>
