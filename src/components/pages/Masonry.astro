---
import config from '../../config';
import { masonryItems } from '../../lib/data';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<style is:global>
  #masonry-container {
    column-count: 3;
    column-gap: 16px;
    min-height: 0 !important;
  }
  #masonry-container .masonry-item {
    position: relative !important;
    display: inline-block;
    width: 100%;
    margin-bottom: 16px;
    break-inside: avoid;
    top: auto !important;
    left: auto !important;
  }
  #masonry-container .image-container {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-medium);
  }
  @media (max-width: 900px) {
    #masonry-container { column-count: 2; }
  }
  @media (max-width: 600px) {
    #masonry-container { column-count: 1; }
  }
</style>

<div class="py-8 sm:py-0">
  <h1 class="page-title-header">{title}</h1>
  <div id="masonry-container" data-batch-size={config.pageTemplates.masonry.batchSize}>
    {masonryItems.map((item) => (
      <div class="masonry-item">
        <div class="image-container">
          <img
            class="masonry-img"
            src={item.image}
            alt={item.title || ''}
            loading="lazy"
            decoding="async"
            data-exif={item.exif ? 'true' : undefined}
          />
          {item.title && <div class="image-title">{item.title}</div>}
          {item.description && <div class="image-description">{item.description}</div>}
        </div>
      </div>
    ))}
  </div>
</div>
