---
import config from '../../config';
import { useTranslations } from '../../lib/i18n';
const t = useTranslations();
interface Props {
  hasToc?: boolean;
  comment?: boolean;
}
const { hasToc = false, comment = true } = Astro.props;
---
<div class="post-tools">
  <ul class="article-tools-list">
    {hasToc && (
      <li class="right-bottom-tools page-aside-toggle" title={t('toc')}>
        <i class="fa-regular fa-outdent" aria-hidden="true"></i>
      </li>
    )}
    {comment && (
      <li class="go-comment" title={t('comments')}>
        <i class="fa-regular fa-comments" aria-hidden="true"></i>
      </li>
    )}
  </ul>
</div>
