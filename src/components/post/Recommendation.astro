---
import config from '../../config';
import type { PostEntry } from '../../lib/posts';
import { getPostImage, getPostPath } from '../../lib/posts';
import { urlFor } from '../../lib/url';

interface Props {
  posts: PostEntry[];
}
const { posts } = Astro.props;
const all = posts.slice(0, config.articles.recommendation.limit);
---

{all.length > 0 && (
  <div class="recommended-article px-2 sm:px-6 md:px-8">
    <div class="recommended-desktop">
      <div class="recommended-article-header text-xl md:text-3xl font-bold mt-10">
        <i aria-hidden="true"></i><span>{config.articles.recommendation.title}</span>
      </div>
      <div class="recommended-article-group">
        {all.map((post) => {
          const image = getPostImage(post) || config.articles.recommendation.placeholder;
          return (
            <a class="recommended-article-item" href={getPostPath(post)} title={post.data.title} rel="bookmark">
              <img src={urlFor(image)} alt={post.data.title} loading="lazy" class="!max-w-none" />
              <span class="title">{post.data.title}</span>
            </a>
          );
        })}
      </div>
    </div>
    <div class="recommended-mobile">
      <div class="recommended-article-header text-xl md:text-3xl font-bold mt-10">
        <i aria-hidden="true"></i><span>{config.articles.recommendation.title}</span>
      </div>
      <div class="recommended-article-group">
        {all.slice(0, config.articles.recommendation.mobileLimit).map((post) => {
          const image = getPostImage(post) || config.articles.recommendation.placeholder;
          return (
            <a class="recommended-article-item" href={getPostPath(post)} title={post.data.title} rel="bookmark">
              <img src={urlFor(image)} alt={post.data.title} loading="lazy" class="!max-w-none" />
              <span class="title">{post.data.title}</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
)}
