---
import config from '../config';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/home/HomeContent.astro';
import { getAllPosts, paginate } from '../lib/posts';

const posts = await getAllPosts();
const { items, current, totalPages } = paginate(posts, 1, config.site.postsPerPage);
---

<BaseLayout
  isHome
  showBanner={config.homeBanner.enable}
  type="website"
  title={undefined}
  description={config.site.description}
>
  <HomeContent posts={items} current={current} total={totalPages} />
</BaseLayout>
